# Copy selected values to your shell or a private local environment file.
# Never commit credentials.
PI_CONFIG_DIR=/path/to/pi-workbench
PI_DOMAIN=wordpress
# Optional overrides. Run `piw paths` to see XDG defaults and legacy fallback.
# PI_STANDARDS_DIR=/absolute/path/to/standards
# PI_TASKS_DIR=/absolute/path/to/tasks
# PI_THINK_DIR=/absolute/path/to/think
# PI_WORKBENCH_CONFIG_DIR=/absolute/path/to/providers
# PI_MODEL_CAPABILITIES_FILE=/absolute/path/to/model-capabilities.json

# Optional router controls:
# PI_ROUTER_ROLE=debugger
# PI_ROUTER_PROVIDER=example-provider
# PI_ROUTER_MODEL=cx/gpt-6.1-sol
# PI_ROUTER_TRACE=1

# Provider credentials belong here or in Pi auth.json, never in this repository.
# EXAMPLE_PROVIDER_BASE_URL=https://provider.example/v1
# EXAMPLE_PROVIDER_API_KEY=
