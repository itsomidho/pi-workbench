{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-workbench.local/schemas/task-report.schema.json",
  "title": "Pi Workbench task report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "task",
    "issue",
    "plan",
    "changes",
    "verification",
    "acceptanceCriteria",
    "findings",
    "outcome",
    "risks",
    "nextSteps",
    "delivery",
    "stages",
    "usage",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "domain",
        "project",
        "execution",
        "status",
        "lifecycleStatus",
        "startedAt"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "execution": {
          "type": "string",
          "enum": [
            "managed",
            "main-session"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "blocked",
            "stopped",
            "in-progress"
          ]
        },
        "lifecycleStatus": {
          "type": "string"
        },
        "startedAt": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "goal"
      ],
      "properties": {
        "request": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval",
        "content",
        "decisions",
        "deviations"
      ],
      "properties": {
        "approval": {
          "type": "string",
          "enum": [
            "recorded",
            "unverified"
          ]
        },
        "content": {
          "type": "string"
        },
        "decisions": {
          "type": "string"
        },
        "deviations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "summary",
          "source"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "command",
          "status",
          "result",
          "evidence",
          "source"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "skipped",
              "unverified"
            ]
          },
          "result": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "status",
          "evidence"
        ],
        "properties": {
          "criterion": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "met",
              "unmet",
              "unverified"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "summary",
          "file",
          "line",
          "status",
          "blocking",
          "evidence",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": [
              "integer",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "resolved",
              "accepted",
              "unknown"
            ]
          },
          "blocking": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "reason"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nextSteps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "committed",
        "published",
        "deployed"
      ],
      "properties": {
        "committed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "evidence"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "yes",
                "no",
                "unknown"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "published": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "evidence"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "yes",
                "no",
                "unknown"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "deployed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "evidence"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "yes",
                "no",
                "unknown"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "status",
          "summary",
          "createdAt",
          "source",
          "evidence"
        ],
        "properties": {
          "stage": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "createdAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "responses",
        "inputTokens",
        "outputTokens",
        "reportedCost",
        "models"
      ],
      "properties": {
        "responses": {
          "type": "integer",
          "minimum": 0
        },
        "inputTokens": {
          "type": "number",
          "minimum": 0
        },
        "outputTokens": {
          "type": "number",
          "minimum": 0
        },
        "reportedCost": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
