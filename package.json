{
  "name": "pi-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "Portable, vendor-neutral Pi configuration, workflows, standards, and adapter tooling.",
  "type": "module",
  "scripts": {
    "check": "node scripts/verify-workflows.mjs",
    "test": "node --test scripts/*.test.mjs",
    "test:adapter": "node --test scripts/adapter-contract.test.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions/model-router.ts",
      "./extensions/task-workflow.ts"
    ],
    "skills": [
      "./skills",
      "./domains/wordpress/skills"
    ],
    "prompts": [
      "./workflows/*.md",
      "./domains/wordpress/workflows/*.md"
    ]
  }
}
